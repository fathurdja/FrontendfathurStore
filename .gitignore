# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db

# IDEs
.idea/
.vscode/

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Credentials & Sensitive Information
.env
.env*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
credentials*.json
client_secret*.json
id_rsa*
auth.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Excel & Spreadsheet Files
*.xlsx
*.xls
*.csv
*.xlsm
*.xlsb
~$*.xlsx
~$*.xls

# Markdown files (except README.md)
*.md
**/*.md
!README.md
!readme.md
!Readme.md
!**/README.md
!**/readme.md
!**/Readme.md
